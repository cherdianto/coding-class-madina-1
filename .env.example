# Google Sheet ID (found in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=

# Service account email, e.g. my-bot@my-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# Service account private key. Keep the quotes and \n escape sequences exactly
# as Google gives them to you in the downloaded JSON key file.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
